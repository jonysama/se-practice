@startuml
hide methods
skinparam classAttributeIconSize 0

class Student {
  studentId : String
  name : String
  +viewAvailability()
  +bookRoom()
  +cancelBooking()
}

class Room {
  roomId : String
  name : String
  isBlocked : Boolean
  +isAvailable(startTime : DateTime, duration : Duration) : Boolean
  +block()
  +unblock()
}

class Booking {
  bookingId : String
  startTime : DateTime
  endTime : DateTime
  status : BookingStatus
  +confirm()
  +cancel()
}

enum BookingStatus {
  ACTIVE
  CANCELLED
}

Student "1" -- "0..*" Booking : makes / owns
Room "1" -- "0..*" Booking : is reserved by
@enduml
